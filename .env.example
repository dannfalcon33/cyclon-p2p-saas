# ==============================================================================
# CYCLON P2P — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de la Aplicación Web
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL (Neon Serverless)
# ------------------------------------------------------------------------------
# Obtén tu URL de conexión en la consola de Neon (https://console.neon.tech):
# Ejemplo: postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ------------------------------------------------------------------------------
# 3. Autenticación (Better Auth)
# ------------------------------------------------------------------------------
# Secreto criptográfico de al menos 32 caracteres para firmar cookies de sesión:
BETTER_AUTH_SECRET=cyclon-p2p-default-secret-32-chars-long-minimum!
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Modo de Facturación (SaaS Demo Portfolio)
# ------------------------------------------------------------------------------
# Cyclon P2P opera en modo de demostración. Nunca procesa cobros ni almacena tarjetas reales.
BILLING_MODE=demo

# ------------------------------------------------------------------------------
# 5. Servicio de Correo Electrónico
# ------------------------------------------------------------------------------
# En local o demo, 'console' imprime los enlaces en la terminal sin requerir API Keys.
# Opciones: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@cyclonp2p.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Bootstrap del Administrador Master de la Plataforma (Platform Owner)
# ------------------------------------------------------------------------------
# Credenciales iniciales para aprovisionar la primera cuenta con rol 'platform_owner'
# ejecutando: npm run auth:bootstrap-owner
INITIAL_PLATFORM_OWNER_EMAIL=admin@cyclonp2p.com
INITIAL_PLATFORM_OWNER_PASSWORD=AdminSecurePassword123!
INITIAL_PLATFORM_OWNER_NAME=Master Administrator

# ------------------------------------------------------------------------------
# 7. Datos de Mercado y Arbitraje Cripto (Enterprise)
# ------------------------------------------------------------------------------
# Las cotizaciones en tiempo real Spot y Klines utilizan endpoints públicos de Binance,
# Bybit, Bitget y Kraken (sin necesidad de API Keys obligatorias).
# Opcional para futuros proveedores ampliados:
MARKET_DATA_PROVIDER=binance_public
MARKET_DATA_API_KEY=
MARKET_NEWS_PROVIDER=criptonoticias_rss
